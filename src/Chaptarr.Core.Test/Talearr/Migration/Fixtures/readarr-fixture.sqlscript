  (21, 2, '1', '1', 'A Book Nobody Has Heard Of', NULL, 'nobody', 1, 1, NULL),
  (30, 3, '2', '2', 'Mystery Thing', NULL, 'mystery', 0, 1, NULL),
  (40, 99, '3', '3', 'Orphan Row Without Author', NULL, 'orphan', 1, 1, NULL);
CREATE TABLE "Editions" ("Id" INTEGER PRIMARY KEY, "BookId" INTEGER NOT NULL, "ForeignEditionId" TEXT NOT NULL, "Isbn13" TEXT, "Asin" TEXT, "Title" TEXT NOT NULL, "Monitored" INTEGER NOT NULL);
INSERT INTO "Editions" VALUES (100, 10, '54493401', '9780593135204', 'B08FHBV4ZX', 'Project Hail Mary', 1),
