<Project>
  <!--
    Talearr fork settings. Kept in its own file so upstream edits to
    Directory.Build.props (including its version bumps) merge cleanly.

    TalearrVersion is the fork's own version, shown in System > Status and in the
    startup log. AssemblyVersion in Directory.Build.props stays the upstream
    Chaptarr version on purpose: update checks, backups, metadata requests and
    database tooling key on it.
  -->
  <PropertyGroup>
    <TalearrVersion Condition="'$(TalearrVersion)' == ''">0.18.15</TalearrVersion>

    <!-- NuGet vulnerability advisories published after an upstream release would otherwise
         fail restore (TreatWarningsAsErrors). Keep them visible as warnings; package bumps
         are left to upstream so merges stay clean. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(ChaptarrProject)'=='true'">
    <AssemblyMetadata Include="TalearrVersion" Value="$(TalearrVersion)" />
  </ItemGroup>
</Project>
